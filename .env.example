# DeepSeek API 키 — 직원별 AI 리포트 생성에 사용
# https://platform.deepseek.com/api_keys 에서 발급
DEEPSEEK_API_KEY=sk-...

# 사용할 모델 (기본: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# (선택) OpenAI 키 — DEEPSEEK_API_KEY가 없을 때만 쓰입니다
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# 사용할 모델 (기본: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
